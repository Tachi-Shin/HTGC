#!/usr/bin/env python3
"""Hyper Text GUI Compiler command-line interface."""

import argparse
from pathlib import Path
from shutil import copyfile
import sys

import backend_dart
from frontend import CompileError, load_program


def main():
    parser = argparse.ArgumentParser(
        description="Hyper Text GUI Compiler — compile HTML/CSS/JavaScript to Dart (Flutter).",
        allow_abbrev=False,
    )
    parser.add_argument("-Dart", action="store_true", help="generate Dart for Flutter (the default)")
    parser.add_argument("html", type=Path, help="HTML entry point")
    parser.add_argument("-o", "--output", type=Path, help="output file (default: input stem with .dart extension)")
    parser.add_argument("--strict", action="store_true", help="compatibility option; unsupported syntax always fails")
    parser.add_argument("--include", action="append", type=Path, default=[],
                        help="include an additional HTML page or image relative to the entry directory")
    args = parser.parse_args()
    try:
        output = args.output or args.html.with_suffix(".dart")
        program = None
        if not args.include:
            try:
                program = load_program(args.html)
            except CompileError:
                pass
        if program is None:
            from native_dart import generate

            asset_name = output.name + ".assets"
            code, site = generate(args.html, includes=args.include, asset_name=asset_name)
            if output.resolve() in site.inputs:
                raise CompileError(f"{output}: 入力ファイルには上書きできません")
            asset_directory = output.parent.resolve() / asset_name
            if site.assets and asset_directory.is_symlink():
                raise CompileError(f"{asset_directory}: 画像の出力先にシンボリックリンクは使えません")
            destinations = []
            for name, source in site.assets.items():
                destination = asset_directory / name
                if not destination.resolve().is_relative_to(asset_directory):
                    raise CompileError(f"{destination}: 画像の出力先ディレクトリ外です")
                if destination.resolve() == source:
                    continue
                if destination.resolve() in site.inputs:
                    raise CompileError(f"{destination}: 入力ファイルには上書きできません")
                destinations.append((source, destination))
            for source, destination in destinations:
                destination.parent.mkdir(parents=True, exist_ok=True)
                copyfile(source, destination)
            output.write_text(code, encoding="utf-8")
            return
        if output.resolve() in program.inputs:
            raise CompileError(f"{output}: 入力ファイルには上書きできません")
        code = backend_dart.generate(program)
        output.write_text(code, encoding="utf-8")
    except (OSError, ValueError, RecursionError) as error:
        parser.exit(1, f"HTGC: {error}\n")


if __name__ == "__main__":
    main()
